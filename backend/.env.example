# Environment: development | staging | production
NODE_ENV=development

PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/database?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/database?schema=public

ACCESS_TOKEN_DURATION=15m
ACCESS_TOKEN_SECRET=your-access-token-secret

REFRESH_TOKEN_DURATION=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret

# GCS Storage Configuration (required for staging/production, not needed for development)
# In development, files are stored locally in the media/ folder
GCS_BUCKET_NAME=your-bucket-name
GCS_PROJECT_ID=your-project-id
GCS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"