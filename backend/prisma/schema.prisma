// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  SUPERVISOR
  EMPLOYEE
}

enum EmploymentType {
  PERMANENT
  TEMPORARY
  FORMER
}

enum Gender {
  MALE
  FEMALE
}

enum TypeOfWork {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
}

enum WorkStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum Level {
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  PAID_LEAVE
  UNPAID_LEAVE
  SICK_LEAVE
  URGENT_LEAVE
}

enum AttendanceCheckoutSource {
  MANUAL
  AUTO
}

model User {
  id                      Int            @id @default(autoincrement())
  fullName                String
  email                   String         @unique
  password                String
  phoneNumber             String?
  position                String?
  role                    Role
  employmentType          EmploymentType
  taxNumber               String?
  identityNumber          String?
  startDate               DateTime?
  leaveDate               DateTime?
  location                String?
  bankNumber              String?
  bankName                String?
  bankAccountHolderName   String?
  photoUrl                String?
  nickname                String?
  gender                  Gender?
  dateOfBirth             DateTime?
  typeOfWork              TypeOfWork?
  workStatus              WorkStatus?
  division                String?
  level                   Level?
  organizationId          Int?
  organization            Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  supervisedOrganizations Organization[] @relation("OrganizationSupervisor")
  scoredKpis              KpiScore[]     @relation("ScoredUser")
  scoredKpisAsScorer      KpiScore[]     @relation("Scorer")
  attendanceRecords       AttendanceRecord[]
  leaveRequests           LeaveRequest[] @relation("LeaveRequester")
  leaveReviews            LeaveRequest[] @relation("LeaveReviewedBy")
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  payrolls                Payroll[]

  @@index([organizationId])
  @@index([email])
}

model Organization {
  id           Int         @id @default(autoincrement())
  name         String
  supervisorId Int
  supervisor   User         @relation("OrganizationSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  members      User[]
  metrics      KpiMetric[]
  periods      KpiPeriod[]
  targets      KpiTarget[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([supervisorId])
}


model KpiMetric {
  id             Int          @id @default(autoincrement())
  name           String
  description    String?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  targets        KpiTarget[]
  scores         KpiScore[]

  @@unique([organizationId, name])
  @@index([isActive])
  @@index([organizationId])
}

model KpiPeriod {
  id             Int          @id @default(autoincrement())
  name           String
  startDate      DateTime
  endDate        DateTime
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  targets        KpiTarget[]
  scores         KpiScore[]

  @@unique([organizationId, name, startDate, endDate])
  @@index([isActive])
  @@index([startDate, endDate])
  @@index([organizationId])
}

model KpiTarget {
  id             Int          @id @default(autoincrement())
  metricId       Int
  periodId       Int
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  target         Decimal      @db.Decimal(3, 1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  metric         KpiMetric   @relation(fields: [metricId], references: [id], onDelete: Restrict)
  period         KpiPeriod    @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([metricId, periodId])
  @@index([periodId])
  @@index([metricId])
  @@index([organizationId])
}

model KpiScore {
  id          Int      @id @default(autoincrement())
  periodId    Int
  metricId    Int
  scoredUserId Int
  scorerId    Int
  score       Decimal  @db.Decimal(3, 1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  period      KpiPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  metric      KpiMetric @relation(fields: [metricId], references: [id], onDelete: Restrict)
  scoredUser  User     @relation("ScoredUser", fields: [scoredUserId], references: [id], onDelete: Restrict)
  scorer      User     @relation("Scorer", fields: [scorerId], references: [id], onDelete: Restrict)

  @@unique([periodId, metricId, scoredUserId, scorerId])
  @@index([periodId])
  @@index([scoredUserId])
  @@index([scorerId])
  @@index([metricId])
}

model AttendanceRecord {
  id             Int                      @id @default(autoincrement())
  userId         Int
  checkInAt      DateTime
  checkOutAt     DateTime?
  checkOutSource AttendanceCheckoutSource @default(MANUAL)
  timezone       String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  user           User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([checkInAt])
  @@index([checkOutAt])
  @@index([userId, checkInAt])
}

model LeaveRequest {
  id           Int         @id @default(autoincrement())
  userId       Int
  type         LeaveType
  reason       String?
  startDate    DateTime
  endDate      DateTime
  status       LeaveStatus @default(PENDING)
  reviewedById Int?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy   User?       @relation("LeaveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([reviewedById])
}

model LeaveEntitlement {
  id           Int      @id @default(autoincrement())
  type         LeaveType
  entitledDays Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([type])
}

model Payroll {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  baseSalary      Decimal
  allowance       Decimal?      @default(0)
  bonuses         Decimal?      @default(0)
  tax             Decimal?      @default(0)
  insurance       Decimal?      @default(0)
  pensionFund     Decimal?      @default(0)
  otherDeductions Decimal?      @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
}
